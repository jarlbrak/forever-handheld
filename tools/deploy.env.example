# Copy to tools/deploy.env (gitignored) and fill in for your machine.
#
# ssh destination of the Steam Deck. Leave empty to install into a folder on this machine.
# A Tailscale MagicDNS name or a LAN hostname both work; key-based ssh login is assumed.
FH_DEPLOY_HOST=deck@steamdeck
#
# The game's AddOns directory on that machine. For a Proton install this lives inside the
# Wine prefix, for example:
#   <prefix>/drive_c/Program Files (x86)/World of Warcraft/_forever_/Interface/AddOns
FH_DEPLOY_ADDONS=/home/deck/path/to/World of Warcraft/_forever_/Interface/AddOns
