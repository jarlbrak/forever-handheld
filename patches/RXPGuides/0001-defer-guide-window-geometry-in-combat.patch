+-- The current step can keep updating its text while the secure targeting
+-- button prevents the container from changing visibility or height.
+local stepLayoutEvents = CreateFrame("Frame")
+local pendingStepHeight, pendingStepShown
+local function applyStepGeometry(height, shown)
+    if InCombatLockdown() then
+        if pendingStepShown == nil then
+            stepLayoutEvents:RegisterEvent("PLAYER_REGEN_ENABLED")
+        end
+        pendingStepHeight, pendingStepShown = height, shown
+        return
+    end
+    if pendingStepShown ~= nil then
+        pendingStepHeight, pendingStepShown = nil, nil
+        stepLayoutEvents:UnregisterEvent("PLAYER_REGEN_ENABLED")
+    end
+    if height ~= nil and CurrentStepFrame:GetHeight() ~= height then
+        CurrentStepFrame:SetHeight(height)
+    end
+    if CurrentStepFrame:IsShown() ~= shown then CurrentStepFrame:SetShown(shown) end
+end
+stepLayoutEvents:SetScript("OnEvent", function()
+    if pendingStepShown ~= nil then applyStepGeometry(pendingStepHeight, pendingStepShown) end
+end)
